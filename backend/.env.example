# Environment Configuration for ShareX Backend
# Copy this file to .env and customize as needed

# Server port (default: 7788)
PORT=7788

# Host display name (default: system hostname)
# HOST_NAME=MyComputer

# 6-digit pairing PIN — auto-generated if not set (shown in terminal on startup)
# SHAREX_PIN=123456

# Require PIN for pairing? Set to 'false' to disable (not recommended on shared networks)
REQUIRE_PIN=true

# Require explicit host approval for each new device?
REQUIRE_APPROVAL=true

# Upload directory (default: ./uploads)
# UPLOAD_DIR=/path/to/uploads

# Received files directory (default: ./received)
# RECEIVED_DIR=/path/to/received

# Maximum file size per transfer in MB (default: 2048 = 2 GB)
MAX_FILE_SIZE_MB=2048

# Maximum total storage quota in GB (default: 10 GB)
MAX_STORAGE_GB=10

# Maximum files per transfer batch (default: 100)
MAX_FILES_PER_TRANSFER=100
